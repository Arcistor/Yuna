[ghost]
personality = "lonely_ghost"
ollama_model = "mistral:7b-instruct-v0.3-q4_K_M"
ollama_url = "http://localhost:11434"

[watch]
# Watch directories you own. Digital Ghost also applies built-in safety excludes
# for system paths such as /proc, /sys, /dev, /etc, /System, and /Library.
paths = ["/Users/you/projects"]
exclude = ["/Users/you/projects/node_modules", "/Users/you/projects/.git"]

[behavior]
# Disabled by default because this can edit .zshrc, .bashrc, or .profile.
alias_injection = false
note_lifetime_minutes = 60

[limits]
max_cpu_percent = 0.5
cooldown_seconds = 60
